set_option autoImplicit false
set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-!
# Gf4Rec: a 30-gate circuit (10 AND, 20 XOR) computes multiplication in GF(2^4) = F_2[x]/(0x13)

Generated by tools/lean/gen_lean.py. Core Lean only, every proof `decide +kernel`.
Elements are `Nat` in [0, 2^4) with bit i the coefficient of x^i. `gmul` is shift-and-add with reduction.
Gates `(op, x, y)`: op 1 = AND, 0 = XOR; signals 0..3 are a_i, 4..7 are b_j, 8 + i is gate i.
`evalPt` keeps every signal's bit in one `Nat` accumulator.
Controls: gate 8 flipped from AND to XOR is refuted, and so is the circuit against the polynomial 0x19.
-/

namespace Gf4Rec

def M : Nat := 4

/-- Multiplication by x modulo `p` (degree M). -/
def xt (p a : Nat) : Nat := if (a <<< 1) &&& (1 <<< M) != 0 then (a <<< 1) ^^^ p else a <<< 1

/-- Carry-less product of a and b reduced mod p, by M shift-and-add rounds. -/
def gmulAux (p : Nat) : Nat → Nat → Nat → Nat → Nat
  | 0, _, _, r => r
  | k + 1, a, b, r => gmulAux p k (xt p a) (b >>> 1) (if b &&& 1 != 0 then r ^^^ a else r)

def gmul (p a b : Nat) : Nat := gmulAux p M a b 0

def run : List (Nat × Nat × Nat) → Nat → Nat → Nat
  | [], acc, _ => acc
  | (op, x, y) :: r, acc, idx =>
    let bx := (acc >>> x) &&& 1
    let bY := (acc >>> y) &&& 1
    let v := if op == 1 then bx &&& bY else bx ^^^ bY
    run r (acc ||| (v <<< idx)) (idx + 1)

def collect : List Nat → Nat → Nat → Nat
  | [], _, _ => 0
  | o :: r, acc, k => (((acc >>> o) &&& 1) <<< k) ||| collect r acc (k + 1)

def evalPt (gs : List (Nat × Nat × Nat)) (outs : List Nat) (a b : Nat) : Nat :=
  collect outs (run gs (a ||| (b <<< M)) (2 * M)) 0

def allOk (p : Nat) (gs : List (Nat × Nat × Nat)) (outs : List Nat) : Bool :=
  (List.range (2 ^ M)).all fun a => (List.range (2 ^ M)).all fun b => evalPt gs outs a b == gmul p a b

def P : Nat := 19
def gates : List (Nat × Nat × Nat) := [(0, 0, 1), (0, 0, 2), (0, 1, 3), (0, 2, 3), (0, 4, 5), (0, 4, 6), (0, 5, 7), (0, 6, 7), (1, 0, 4), (1, 2, 6), (1, 9, 13), (1, 1, 5), (1, 3, 7), (1, 10, 14), (1, 8, 12), (1, 8, 15), (1, 11, 12), (1, 11, 15), (0, 17, 21), (0, 19, 16), (0, 20, 26), (0, 28, 27), (0, 22, 25), (0, 30, 21), (0, 31, 16), (0, 18, 27), (0, 25, 33), (0, 23, 24), (0, 35, 26), (0, 36, 33)]
def outs : List Nat := [29, 32, 34, 37]
def gatesMut : List (Nat × Nat × Nat) := [(0, 0, 1), (0, 0, 2), (0, 1, 3), (0, 2, 3), (0, 4, 5), (0, 4, 6), (0, 5, 7), (0, 6, 7), (0, 0, 4), (1, 2, 6), (1, 9, 13), (1, 1, 5), (1, 3, 7), (1, 10, 14), (1, 8, 12), (1, 8, 15), (1, 11, 12), (1, 11, 15), (0, 17, 21), (0, 19, 16), (0, 20, 26), (0, 28, 27), (0, 22, 25), (0, 30, 21), (0, 31, 16), (0, 18, 27), (0, 25, 33), (0, 23, 24), (0, 35, 26), (0, 36, 33)]

/-- Sanity: `gmul` is the field multiplication: x * x^(M-1) reduces to the low part of P. -/
theorem gmul_sanity : gmul P 2 (1 <<< (M - 1)) = P ^^^ (1 <<< M) := by decide +kernel

def chunk (j : Nat) : Bool :=
  (List.range 1).all fun i => (List.range (2 ^ M)).all fun b =>
    evalPt gates outs (1 * j + i) b == gmul P (1 * j + i) b

theorem chunk_0 : chunk 0 = true := by decide +kernel
theorem chunk_1 : chunk 1 = true := by decide +kernel
theorem chunk_2 : chunk 2 = true := by decide +kernel
theorem chunk_3 : chunk 3 = true := by decide +kernel
theorem chunk_4 : chunk 4 = true := by decide +kernel
theorem chunk_5 : chunk 5 = true := by decide +kernel
theorem chunk_6 : chunk 6 = true := by decide +kernel
theorem chunk_7 : chunk 7 = true := by decide +kernel
theorem chunk_8 : chunk 8 = true := by decide +kernel
theorem chunk_9 : chunk 9 = true := by decide +kernel
theorem chunk_10 : chunk 10 = true := by decide +kernel
theorem chunk_11 : chunk 11 = true := by decide +kernel
theorem chunk_12 : chunk 12 = true := by decide +kernel
theorem chunk_13 : chunk 13 = true := by decide +kernel
theorem chunk_14 : chunk 14 = true := by decide +kernel
theorem chunk_15 : chunk 15 = true := by decide +kernel

/-- Every a in [0, 2^M) is 1 * j + i with j < 16, i < 1. -/
def allOkC : Bool := chunk 0 && chunk 1 && chunk 2 && chunk 3 && chunk 4 && chunk 5 && chunk 6 && chunk 7 && chunk 8 && chunk 9 && chunk 10 && chunk 11 && chunk 12 && chunk 13 && chunk 14 && chunk 15

/-- The circuit equals GF(2^M) multiplication mod P on all 2^(2M) input pairs. -/
theorem circuit_ok : allOkC = true := by
  simp only [allOkC, chunk_0, chunk_1, chunk_2, chunk_3, chunk_4, chunk_5, chunk_6, chunk_7, chunk_8, chunk_9, chunk_10, chunk_11, chunk_12, chunk_13, chunk_14, chunk_15, Bool.and_self]

/-- Control: the circuit with gate 8 flipped AND -> XOR is wrong somewhere. -/
theorem control_mutant : allOk P gatesMut outs = false := by decide +kernel

/-- Control: the circuit is NOT multiplication modulo the other irreducible 0x19. -/
theorem control_wrong_poly : allOk 25 gates outs = false := by decide +kernel

end Gf4Rec

